# LLM Configuration for Standardizer
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Development fallback (set to 1 to use mock tags when API key is missing)
LIBRARIAN_ALLOW_MOCK_LLM=1

# Optional: Custom data directories
# LIBRARIAN_RAW_DIR=./data
# LIBRARIAN_REFINED_DIR=./data-refined
# LIBRARIAN_REGISTRY=./config/registry.json
# LIBRARIAN_STATS_PATH=./state/libraries.stats.json
