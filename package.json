{
  "name": "librarian",
  "version": "1.0.0",
  "description": "Agentic Search: The Librarian Pattern for AI Knowledge Hub",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "sync": "bun src/aggregator/sync.ts",
    "standardize": "bun src/standardizer/cli.ts",
    "manifest": "bun src/hub/manifest-gen.ts",
    "build": "bun run sync && bun run standardize && bun run manifest",
    "smoke": "bun tests/smoke.ts",
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
